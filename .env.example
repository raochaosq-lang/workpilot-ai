# Senlo cloud sync configuration
#
# This project is currently a static HTML prototype. Static HTML cannot read
# .env files directly at runtime, so these values are primarily for future
# Vite/hosting integration and documentation. In the current app, you can also
# paste the same values in the local-only developer panel:
# http://localhost:8001/?devCloud=1 -> 开发者配置.

VITE_TCB_ENV_ID=your-cloudbase-env-id
VITE_TCB_REGION=ap-shanghai
VITE_TCB_ACCESS_KEY=your-cloudbase-web-access-key
SENLO_ENABLE_CLOUD_SYNC=true

# Never put Tencent Cloud SecretId/SecretKey, model API keys, or private user data here.
